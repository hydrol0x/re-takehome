import Mathlib

theorem putnam_2018_a1
  (a b : ℤ)
  (h : 0 < a ∧ 0 < b) :
  ((1 : ℚ) / a + (1 : ℚ) / b = (3 : ℚ) / 2018) ↔
    (⟨a, b⟩ ∈ ({(673, 1358114), (674, 340033), (1009, 2018),
      (2018, 1009), (340033, 674), (1358114, 673)} : Set (ℤ × ℤ))) := by
  have h_main : ((1 : ℚ) / a + (1 : ℚ) / b = (3 : ℚ) / 2018) ↔
    (a = 673 ∧ b = 1358114) ∨
    (a = 674 ∧ b = 340033) ∨
    (a = 1009 ∧ b = 2018) ∨
    (a = 2018 ∧ b = 1009) ∨
    (a = 340033 ∧ b = 674) ∨
    (a = 1358114 ∧ b = 673) := by sorry
  
  have h_set_mem : 
    ((a = 673 ∧ b = 1358114) ∨
     (a = 674 ∧ b = 340033) ∨
     (a = 1009 ∧ b = 2018) ∨
     (a = 2018 ∧ b = 1009) ∨
     (a = 340033 ∧ b = 674) ∨
     (a = 1358114 ∧ b = 673)) ↔
    (⟨a, b⟩ ∈ ({(673, 1358114), (674, 340033), (1009, 2018),
      (2018, 1009), (340033, 674), (1358114, 673)} : Set (ℤ × ℤ))) := by norm_num
  
  rw [h_main]
  rw [h_set_mem]
