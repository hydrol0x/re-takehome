import Mathlib

/-- (a): `23 ∣ 2 ^ n - 1` iff `11 ∣ n`, for positive `n`. -/


theorem h02_a (n : ℕ) (hn : 0 < n) : 23 ∣ 2 ^ n - 1 ↔ 11 ∣ n := by
  constructor
  · intro h
    -- If 23 divides 2^n - 1, then 2^n ≡ 1 (mod 23)
    have h_mod : (2 : ℤ) ^ n % 23 = 1 := by
      rw [Int.emod_eq_of_lt]
      · norm_num at h ⊢
        omega
      · norm_num
    -- The order of 2 mod 23 is 11
    have h_order : ∀ k : ℕ, 0 < k → (2 : ℤ) ^ k % 23 = 1 → 11 ∣ k := by
      intro k hk h_k
      -- Check all possible orders dividing 22
      have : k % 22 = 0 ∨ k % 22 = 1 ∨ k % 22 = 2 ∨ k % 22 = 3 ∨ 
             k % 22 = 4 ∨ k % 22 = 5 ∨ k % 22 = 6 ∨ k % 22 = 7 ∨ 
             k % 22 = 8 ∨ k % 22 = 9 ∨ k % 22 = 10 ∨ k % 22 = 11 ∨ 
             k % 22 = 12 ∨ k % 22 = 13 ∨ k % 22 = 14 ∨ k % 22 = 15 ∨ 
             k % 22 = 16 ∨ k % 22 = 17 ∨ k % 22 = 18 ∨ k % 22 = 19 ∨ 
